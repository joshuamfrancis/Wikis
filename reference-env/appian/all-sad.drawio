  <diagram id="Figure_2_â€”_Customer-hosted_receiver" name="Figure 2 â€” Customer-hosted receiver">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="Customer-hosted receiver â€” capture once, fan out to Splunk (90 days) and the NAS archive" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontColor=#1F3A5F;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1140" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Appian Cloud&lt;/b&gt;&lt;br&gt;&lt;br&gt;Log Streaming (syslog)&lt;br&gt;+ optional HEC events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF0F6;strokeColor=#4A72A0;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Customer-hosted receiver&lt;/b&gt;&lt;br&gt;&lt;br&gt;rsyslog Â· syslog-ng Â· SC4S Â· Cribl Â· Vector&lt;br&gt;buffer / persistent queue&lt;br&gt;fan out to two destinations&lt;br&gt;&lt;br&gt;&lt;i&gt;Deploy on a VM (e.g. VMware), physical&lt;/i&gt;&lt;br&gt;&lt;i&gt;host, or container&lt;/i&gt;&lt;br&gt;&lt;i&gt;HA: redundant receivers behind a shared VIP&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1EA;strokeColor=#3E7A55;strokeWidth=2.5;align=center;verticalAlign=middle;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="130" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Splunk â€” searchable 90 days&lt;/b&gt;&lt;br&gt;dashboards Â· alerts Â· SLIs&lt;br&gt;&lt;i&gt;no long-term archive held here&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF4F9;strokeColor=#2E5E8C;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="810" y="140" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Network drive / NAS&lt;/b&gt;&lt;br&gt;long-term archive â€” system of record&lt;br&gt;compressed Â· hashed / signed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F1EA;strokeColor=#3E7A55;strokeWidth=1;align=center;verticalAlign=middle;fontSize=11;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="810" y="270" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="TLS syslog Â· TCP Â· over VPN" style="html=1;strokeColor=#2E5E8C;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#2E5E8C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="HEC (behind VIP)" style="html=1;strokeColor=#2E5E8C;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#2E5E8C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="raw archive" style="html=1;strokeColor=#3E7A55;strokeWidth=2;dashed=0;endArrow=block;endFill=1;fontSize=10;fontColor=#3E7A55;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="line;html=1;strokeColor=#C9D4E0;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="1120" height="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Role:&lt;/b&gt; terminate TLS syslog from Appian, buffer the stream (capture gaps are unrecoverable), and fan out to Splunk (90-day) and the NAS (long-term)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="432" width="1120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;Transport:&lt;/b&gt; TCP + TLS (ideally mTLS) over the VPN â€” avoid UDP.   &lt;b&gt;Reliability:&lt;/b&gt; disk-assisted queues; redundant receivers behind a VIP; monitor for gaps." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="472" width="1120" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;VIP&lt;/b&gt; = virtual IP: one stable address fronting several receivers, so failover is invisible to Appian. Syslog has no application-level ACK, so HA is &#x27;mostly available&#x27; â€” a few in-flight events can still be lost at failover." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBEEE9;strokeColor=#B0472B;align=left;verticalAlign=middle;spacingLeft=10;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="516" width="1120" height="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
