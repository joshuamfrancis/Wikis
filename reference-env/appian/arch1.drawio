        <mxCell id="c11" value="&lt;b&gt;Business Operations User&lt;/b&gt;&lt;br&gt;&lt;i&gt;few · whole platform&lt;/i&gt;&lt;br&gt;&lt;br&gt;Review form templates, check&lt;br&gt;for sensitive data, publish&lt;br&gt;templates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D4E0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=11;arcSize=6;" vertex="1" parent="1">
