        <mxCell id="c9" value="&lt;b&gt;Platform Administrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;1–2 users · whole platform&lt;/i&gt;&lt;br&gt;&lt;br&gt;Administer the platform: SSO,&lt;br&gt;environments, configuration,&lt;br&gt;deployments." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D4E0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=11;arcSize=6;" vertex="1" parent="1">
