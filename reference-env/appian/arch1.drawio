        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;Functional Administrator&lt;/b&gt;&lt;br&gt;&lt;i&gt;2–3 per functional area&lt;/i&gt;&lt;br&gt;&lt;br&gt;Define forms and workflows;&lt;br&gt;extract reports." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C9D4E0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=11;arcSize=6;" vertex="1" parent="1">
