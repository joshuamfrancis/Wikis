# ============================================================
# AD Lab - Configuration Variables
# ============================================================
# Edit the USER CONFIG section before running deploy-ad-lab.sh
# The deploy script APPENDS all created resource IDs below the
# marker line at the bottom, so decommission-ad-lab.sh can
# source this same file to tear everything down.
# ============================================================

# ---------- USER CONFIG (edit these) ----------
export AWS_PROFILE=default
export AWS_REGION=us-east-1
export KEY_NAME=ad-lab-key                # created automatically if missing

export DOMAIN_FQDN=corp.lab
export DOMAIN_NETBIOS=CORP
export DC_IP=10.50.1.10

export VPC_A_CIDR=10.50.0.0/16            # onprem-sim
export VPC_B_CIDR=10.60.0.0/16            # aws-workload
export SUBNET_A_CIDR=10.50.1.0/24
export SUBNET_A2_CIDR=10.50.2.0/24
export SUBNET_B1_CIDR=10.60.1.0/24
export SUBNET_B2_CIDR=10.60.2.0/24

export INSTANCE_TYPE=t3.medium

# Lab-only passwords. NEVER use this pattern outside a lab.
export LOCAL_ADMIN_PASSWORD='LabP@ssw0rd2026!'
export DSRM_PASSWORD='DsrmP@ssw0rd2026!'
export JOIN_SVC_PASSWORD='JoinSvcP@ss1!'
export LAB_USER_PASSWORD='LabUserP@ss1!'

# Set to "true" to also create the optional inbound resolver endpoint (Step 9)
export CREATE_INBOUND_RESOLVER=false

# ---------- RUNTIME STATE (appended by deploy script - do not edit) ----------
# === DEPLOYED_RESOURCES_BELOW ===