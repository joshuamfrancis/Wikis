        <!-- ===== S3 ===== -->
        <mxCell id="s3" value="S3 â€” pcap bucket&#xa;&lt;font style=&quot;font-size:10px;color:#1E8E3E&quot;&gt;SSE-KMS Â· Object Lock Â· versioned&lt;/font&gt;&#xa;&lt;font style=&quot;font-size:10px;color:#37474F&quot;&gt;s3://â€¦/capture-id=&amp;lt;ticket&amp;gt;/az=&amp;lt;az&amp;gt;/&lt;br/&gt;rotated by -G / -W, uploaded via -z hook&lt;/font&gt;&#xa;&lt;font style=&quot;font-size:10px;color:#1E8E3E&quot;&gt;Lifecycle â†’ Glacier â†’ expire&lt;/font&gt;&#xa;&lt;font style=&quot;font-size:10px;color:#5F6B74&quot;&gt;Athena / Wireshark for analysis&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#1E8E3E;strokeWidth=2;verticalAlign=top;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#0D652D;" vertex="1" parent="1">
