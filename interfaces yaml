---
# System Interface Registry
# Version: 1.0
# Description: Defines all system-to-system interfaces for architecture documentation

metadata:
  project: "Enterprise Integration Architecture"
  version: "1.0.0"
  owner: "Architecture Team"
  last_updated: "2026-04-28"

interfaces:
  - id: IF-001
    name: "CRM to Data Warehouse ETL"
    description: "Customer data sync from Salesforce CRM to Snowflake DWH"

    source:
      system: "Salesforce CRM"
      type: "SaaS"
      environment: "Production"
      host: "org.salesforce.com"
      owner: "Sales Operations"

    target:
      system: "Snowflake Data Warehouse"
      type: "Cloud Database"
      environment: "Production"
      host: "account.snowflakecomputing.com"
      owner: "Data Engineering"

    transport:
      protocol: "HTTPS"
      port: 443
      direction: "unidirectional"   # unidirectional | bidirectional

    security:
      authentication:
        method: "OAuth2"            # OAuth2 | API_Key | Basic | Certificate | SAML | None
        token_endpoint: "https://login.salesforce.com/services/oauth2/token"
      authorization:
        model: "RBAC"               # RBAC | ABAC | ACL | None
        roles:
          - "etl_service_account"

    data:
      description: "Customer profiles, opportunities, account records"
      entities:
        - "Account"
        - "Contact"
        - "Opportunity"
      format: "JSON"                # JSON | CSV | XML | Parquet | Avro | Fixed-Width | Binary
      volume_per_run: "~50MB"
      sensitivity: "PII"            # Public | Internal | Confidential | PII | PHI

    scheduling:
      frequency: "scheduled"        # realtime | scheduled | event-driven | manual | batch
      cron: "0 2 * * *"             # 02:00 UTC daily
      timezone: "UTC"
      window: "02:00-03:00 UTC"

    execution:
      container: "etl-salesforce-dwh"
      image: "joshuamfrancis/etl-salesforce:1.4.2"
      platform: "Docker"            # Docker | Kubernetes | Lambda | ECS | Glue | Airflow
      orchestrator: "Apache Airflow"
      dag_id: "salesforce_to_snowflake_daily"
      resource_profile:
        cpu: "2"
        memory: "4Gi"

    monitoring:
      sla_minutes: 60
      alert_email: "data-team@company.com"
      health_check_url: "https://airflow.internal/health/IF-001"

    tags:
      - "etl"
      - "crm"
      - "data-warehouse"

  - id: IF-002
    name: "Order Service to Notification Service"
    description: "Real-time order events pushed to notification microservice"

    source:
      system: "Order Service"
      type: "Microservice"
      environment: "Production"
      host: "order-service.internal"
      owner: "Commerce Team"

    target:
      system: "Notification Service"
      type: "Microservice"
      environment: "Production"
      host: "notification-service.internal"
      owner: "Platform Team"

    transport:
      protocol: "AMQP"             # HTTPS | AMQP | MQTT | SFTP | Kafka | gRPC | JDBC | S3
      port: 5672
      direction: "unidirectional"
      broker: "RabbitMQ"
      queue: "order.events"

    security:
      authentication:
        method: "API_Key"
        header: "X-API-KEY"
      authorization:
        model: "ACL"
        permissions:
          - "queue:publish"

    data:
      description: "Order lifecycle events (created, paid, shipped, delivered)"
      entities:
        - "OrderEvent"
      format: "JSON"
      schema_registry: "https://schema-registry.internal/order-events"
      volume_per_run: "~1000 events/min"
      sensitivity: "Confidential"

    scheduling:
      frequency: "realtime"
      latency_target_ms: 500

    execution:
      container: "order-service"
      image: "joshuamfrancis/order-service:3.1.0"
      platform: "Kubernetes"
      namespace: "commerce"
      replicas: 3

    monitoring:
      sla_minutes: 1
      alert_email: "platform-team@company.com"

    tags:
      - "event-driven"
      - "messaging"
      - "ecommerce"

  - id: IF-003
    name: "ERP to Reporting Portal (CSV Export)"
    description: "Weekly financial data extract from SAP ERP to reporting portal via SFTP"

    source:
      system: "SAP ERP"
      type: "On-Premise"
      environment: "Production"
      host: "sap-erp.company.local"
      owner: "Finance IT"

    target:
      system: "Reporting Portal"
      type: "Web Application"
      environment: "Production"
      host: "reports.company.com"
      owner: "Finance Operations"

    transport:
      protocol: "SFTP"
      port: 22
      direction: "unidirectional"

    security:
      authentication:
        method: "Certificate"
        key_path: "/secrets/sftp/erp_rsa_key"
      authorization:
        model: "ACL"
        permissions:
          - "sftp:write"
          - "directory:/finance/inbound"

    data:
      description: "Weekly P&L, Balance Sheet, Cost Centre reports"
      entities:
        - "ProfitLoss"
        - "BalanceSheet"
        - "CostCentre"
      format: "CSV"
      delimiter: ","
      encoding: "UTF-8"
      volume_per_run: "~5MB"
      sensitivity: "Confidential"

    scheduling:
      frequency: "scheduled"
      cron: "0 6 * * 1"            # 06:00 UTC every Monday
      timezone: "UTC"

    execution:
      container: "sap-sftp-exporter"
      image: "joshuamfrancis/sap-exporter:2.0.1"
      platform: "Docker"
      orchestrator: "cron"

    monitoring:
      sla_minutes: 120
      alert_email: "finance-it@company.com"

    tags:
      - "finance"
      - "reporting"
      - "sftp"
      - "batch"